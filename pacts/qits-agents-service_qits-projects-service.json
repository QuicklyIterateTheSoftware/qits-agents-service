{
  "consumer": {
    "name": "qits-agents-service"
  },
  "interactions": [
    {
      "comments": {
        "references": {
          "qits-call": {
            "app": "qits-projects-service",
            "operationId": "listProjects"
          },
          "qits-trigger": {
            "app": "RosterReconcile",
            "event": "StartupEvent",
            "kind": "event"
          }
        }
      },
      "description": "StartupEvent: listProjects",
      "key": "8cdb4a8",
      "pending": false,
      "providerStates": [
        {
          "name": "a project exists",
          "params": {
            "projectId": "00000000-0000-4000-8000-000000000001"
          }
        }
      ],
      "request": {
        "method": "GET",
        "path": "/projects/api/projects"
      },
      "response": {
        "body": {
          "content": {
            "entries": [
              {
                "project": {
                  "id": "00000000-0000-4000-8000-000000000001",
                  "slug": "contract-00000001"
                }
              }
            ]
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.entries": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.entries[*].project.id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
                }
              ]
            },
            "$.entries[*].project.slug": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          },
          "header": {
            "Content-Type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "application/json.*"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    }
  ],
  "metadata": {
