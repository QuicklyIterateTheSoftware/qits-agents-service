<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>eu.wohlben.qits</groupId>
        <artifactId>qits-agents</artifactId>
        <version>2026.1126.42123</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <!-- The deployable: the REST surface under /agents/api, the roster reconcile's triggers, and the
         qits-projects and qits-idp clients behind the domain's interfaces. -->
    <artifactId>qits-agents-service</artifactId>
    <name>qits-agents :: service</name>
    <packaging>quarkus</packaging>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-agents-domain</artifactId>
        </dependency>
        <dependency>
            <!-- The qits project's roster, found by ServiceLoader at boot (RosterReconcile). Compile
                 scope: the roster jar IS what this service deploys; a roster release is a release
                 of this service. -->
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-agents-roster</artifactId>
        </dependency>
        <dependency>
            <!-- AgentImage.VERSION: the `qits/agent` tag every AGENT lease runs (runtime/AgentSpecs). -->
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-agents-daemon-protocol</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-openapi</artifactId>
        </dependency>
        <dependency>
            <!-- /agents/q/health/ready, with a readiness check per datasource. -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-health</artifactId>
        </dependency>
        <dependency>
            <!-- The periodic re-run of the roster reconcile (RosterReconcileTrigger). -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-scheduler</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-eventstream</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-auth-core</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-http-core</artifactId>
        </dependency>
        <dependency>
            <!-- Bearer validation against qits-idp. -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-oidc</artifactId>
        </dependency>
        <dependency>
            <!-- The token this service PRESENTS: the named client `qits` (the idp:client resource),
                 spent by qits-eventstream and qits-telemetry-core, and by the qits-projects read of
                 the reconcile (projects/ServiceBearer). -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-oidc-client</artifactId>
        </dependency>
        <dependency>
            <!-- The MicroProfile REST clients of qits-projects' project list and qits-idp's
                 commissioned-token doors (projects/ProjectsApi, idp/IdpTokensApi). -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-client-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-security</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-opentelemetry</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-telemetry-core</artifactId>
        </dependency>
        <dependency>
            <!-- TrustAnchors.envEntry()/pem(): QITS_TRUST_ANCHORS on an agent's container, when a
                 bundle is held (qits-2636, runtime/PlatformTrustAnchors). -->
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-trust-core</artifactId>
        </dependency>

        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- @TestSecurity: each suite states who is calling. -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-test-security</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- CausationRowRules, HttpClientRules, DatasourceBaselineRules, DeskAdminParityRules,
                 EntityExposureRules and ProviderStateCoverageRules. -->
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-arch-rules</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- The userflow catalogue: browserless @UserStory ITs whose reports, network diagrams
                 included, are written under target/userstories/. -->
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-userflows</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- idp.MockIdp: discovery, JWKS and token minting for the packaged ITs. -->
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-service-mock</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- EventstreamPactTest: what qits-eventstream asks qits-events on this service's
                 behalf (the outbox publish). -->
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-eventstream-contracts</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- ConsumerPactVerificationTest: verifies the consumer pacts this provider pins (none
                 yet). -->
            <groupId>au.com.dius.pact.provider</groupId>
            <artifactId>junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- The consumer pacts against qits-idp-service and qits-projects-service
                 (contracts/consumer/). -->
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-pact-consumer</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>au.com.dius.pact.consumer</groupId>
            <artifactId>junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-idp-golden-masters</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-projects-golden-masters</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- What qits-system answers the AGENT tenant's lease calls (SystemPactTest). -->
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-system-golden-masters</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- The store every @QuarkusTest here boots against: real postgres binaries, spawned
                 as a child process. -->
            <groupId>io.zonky.test</groupId>
            <artifactId>embedded-postgres</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.zonky.test.postgres</groupId>
            <artifactId>embedded-postgres-binaries-linux-amd64</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.zonky.test.postgres</groupId>
            <artifactId>embedded-postgres-binaries-linux-arm64v8</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- The musl build, for the platform's own CI (Alpine step containers). -->
            <groupId>io.zonky.test.postgres</groupId>
            <artifactId>embedded-postgres-binaries-linux-amd64-alpine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.zonky.test.postgres</groupId>
            <artifactId>embedded-postgres-binaries-darwin-arm64v8</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <extensions>true</extensions>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <systemPropertyVariables>
                        <!-- quarkus.package.output-name, spelled again: the two move together. -->
                        <native.image.path>${project.build.directory}/qits-agents</native.image.path>
                        <quarkus.http.test-port>0</quarkus.http.test-port>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                    </systemPropertyVariables>
                    <environmentVariables>
                        <QITS_DOMAIN>wohlben.eu</QITS_DOMAIN>
                    </environmentVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>io.smallrye</groupId>
                <artifactId>jandex-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- GraalVM native build: `-Dnative`. -->
        <profile>
            <id>native</id>
            <activation>
                <property>
                    <name>native</name>
                </property>
            </activation>
            <properties>
                <quarkus.package.jar.enabled>false</quarkus.package.jar.enabled>
                <skipITs>false</skipITs>
                <quarkus.native.enabled>true</quarkus.native.enabled>
            </properties>
        </profile>
    </profiles>
</project>
